JWT_SECRET = your_jwt_secret_key_here
JWT_EXPIRES_IN = your_jwt_expiration_time_here
PORT = your_port_here

# Ejemplo de conexión local
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_HOST=your_db_host_here
DB_PORT=your_db_port_here
DB_NAME=your_db_name_here

# O si tienes una URL completa (como la que da Supabase o Render):
# DATABASE_URL=postgresql://usuario:password@host:5432/radiadores_amazona_db

RESEND_API_KEY=your_resend_api_key_here

# Webhook de n8n que consulta los precios de la competencia en la BD externa (Neon).
# Debe aceptar GET con query params ?sku=...&days=... y devolver filas { dia, precio }.
N8N_COMPETITOR_PRICES_URL=https://n8n.srv1038201.hstgr.cloud/webhook/competitor-prices